{
  "title": "Pluto Storage & Rate Limits",
  "panels": [
    {
      "title": "SQLite Query Latency",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pluto_sqlite_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "{{operation}}"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "title": "Migration Status",
      "type": "table",
      "targets": [
        {"expr": "count by (user_id) (pluto_storage_migration_status)", "format": "table"}
      ],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "title": "Rate Limit Hits",
      "type": "graph",
      "targets": [
        {"expr": "rate(pluto_rate_limit_hits_total[5m])", "legendFormat": "{{action}} {{source}}"}
      ],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "title": "Rate Limit Rejections",
      "type": "graph",
      "targets": [
        {"expr": "rate(pluto_rate_limit_rejections_total[5m])", "legendFormat": "{{action}} {{source}}"}
      ],
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
    },
    {
      "title": "Bucket State (sample, aggregated — identity labels are privileged)",
      "type": "graph",
      "targets": [
        {"expr": "topk(20, sum by (action, metric) (pluto_rate_limit_bucket_state))", "legendFormat": "{{action}} {{metric}}"}
      ],
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8}
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s"
}
