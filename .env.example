# Pluto — copy to .env and fill (never commit .env)
# See README.md Environment variables table.

# --- LLM tiers (at least one required) ---
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
COHERE_API_KEY=your_cohere_key_here
# Retired (do NOT set — removed from cascade): CEREBRAS_API_KEY
# (payment_required), GITHUB_MODELS_TOKEN, NVIDIA_API_KEY,
# OPENCODE_API_KEY free lanes (MissingSessionID), MISTRAL_API_KEY
# (lane removed Sep 2026, superseded by local cheap tier).
# Paid alternatives need code changes in config.py, not just env.
GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_38_MODEL=gemini-3.8-flash      # override
# GEMINI_37_MODEL=gemini-3.7-flash      # override
# GEMINI_36_MODEL=gemini-3.6-flash      # override
# GEMINI_35_MODEL=gemini-3.5-flash      # override (backup)
# GEMINI_35_LITE_MODEL=gemini-3.5-flash-lite  # override (fresh quota pool)
# GEMINI_31_LITE_MODEL=gemini-3.1-flash-lite  # override (last Gemini lane)
# COHERE_MODEL=command-a-03-2025           # override
# COHERE_MODEL=command-a-vision-07-2025    # vision-capable model: makes the
#                                          # Cohere tier a backup image lane
#                                          # behind the Gemini vision lanes
# (Qwen 27B lane removed — see OPENROUTER_LING_VL_MODEL below for the
# remaining trial lane.)
# OPENROUTER_LING_VL_MODEL=inclusionai/ling-3.0-flash-vl:free  # override (vision trial)
# Local Ollama (offline fallback tail, LAST in cascade — cloud quality first):
# OLLAMA_ENABLED=true
# OLLAMA_MODEL=qwen3:8b            # synthesis tail
# PLUTO_FIRST_TOKEN_TIMEOUT_OLLAMA=120  # first-token budget (cold multi-GB load)
# TokenHarbor lanes removed (trial ended) — no TOKENHARBOR_* vars.

# --- App ---
PLUTO_AUTH_MODE=open
# PLUTO_AUTH_MODE=private              # public deploys: use private + tokens
# PLUTO_ACCESS_TOKENS=token1,token2
# PLUTO_USER_ID=local-dev-user
# PLUTO_DATA_DIR=data
# PLUTO_FRONTEND_ORIGIN=http://localhost:5173  # required in private mode (fail-closed)
# PLUTO_TRUSTED_HOSTS=api.example.com
# PLUTO_TRUST_PROXY=false              # set true when behind Render/Vercel trusted proxy to use X-Forwarded-For
# PLUTO_ALLOW_OPEN=false               # true opts into public-host open mode (fail-closed default refuses to start)
# PLUTO_ALLOW_SHARED_VAULT=false       # true opts into PLUTO_USER_ID+open sharing one vault on a public host
# PLUTO_ALLOW_MEMORY_LIMITER=false     # true opts into per-process limits with UVICORN_WORKERS>1 and no REDIS_URL
# VITE_API_URL=                        # set on Vercel to backend URL
# REDIS_URL=redis://localhost:6379/0   # required for UVICORN_WORKERS>1 in private mode
# UVICORN_WORKERS=1                    # >1 requires REDIS_URL in private mode
# PLUTO_SCHEDULER_ENABLED=true
# PLUTO_HYGIENE_INTERVAL_SECONDS=21600
# PLUTO_HYGIENE_JITTER_RATIO=0.10
# PLUTO_HEALTH_PROBE=1                 # 0 disables live-tier network probe on /api/health
# OTEL_EXPORTER_OTLP_ENDPOINT=         # unset = NoOp tracing; OTEL_TRACES_EXPORTER=console for local debug
# OTEL_TRACES_EXPORTER=

# --- Gmail / Calendar (optional, Desktop OAuth) ---
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# --- Storage / KB ---
# PLUTO_KB_EMBED_MODEL=models/gemini-embedding-001
# PLUTO_MCP_SERVERS=[]
# PLUTO_MCP_ALLOW_TOOLS=

# --- Free-tier durability (snapshots, optional) ---
# Mirrors data/ to S3-compatible storage so accounts + chats survive
# Render free-tier restarts. Leave unset for local dev / paid-disk deploys.
# Option 1 — Cloudflare R2 (10 GB free; needs a card on file):
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_BUCKET=pluto-data
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Option 2 — Supabase Storage (1 GB free, no card; enable the S3 protocol
# in Storage settings, create a private bucket, generate S3 access keys):
# R2_BUCKET=pluto-data
# R2_ACCESS_KEY_ID=your_supabase_s3_access_key_id
# R2_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key
# SNAPSHOT_ENDPOINT_URL=https://your_ref.storage.supabase.co/storage/v1/s3
# SNAPSHOT_REGION=your_project_region
# SNAPSHOT_INTERVAL_SECONDS=10
# SNAPSHOT_ENABLED=true
